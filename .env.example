# ===========================================
# JASS Palian - Variables de Entorno
# ===========================================
# Copia este archivo a .env y edita los valores
# cp .env.example .env
# ===========================================

# -------------------------------------------
# BASE DE DATOS (MySQL)
# -------------------------------------------
DB_ROOT_PASSWORD=root123
DB_NAME=jasspalian_db
DB_USER=jass_user
DB_PASSWORD=JassPalian2024
DB_PORT_HOST=3307

# -------------------------------------------
# DJANGO BACKEND
# -------------------------------------------
# Genera una clave segura: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-cambia-esta-clave-en-produccion-por-una-segura

# Debug: 1=activado, 0=desactivado (producción debe ser 0)
DEBUG=1

# Hosts permitidos (separados por comas)
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Puerto del backend
BACKEND_PORT=8000

# Tarifas JASS (configurables)
JASS_TARIFA_POR_M3=3.50
JASS_CARGO_FIJO_DEFAULT=25.00
JASS_CARGO_ALCANTARILLADO_DEFAULT=15.00

# Timeouts de conexión a BD
DB_WAIT_TIMEOUT=60
DB_WAIT_INTERVAL=2

# -------------------------------------------
# FRONTEND (Next.js)
# -------------------------------------------
FRONTEND_PORT=3000

# URL pública de la API (para el navegador)
# En desarrollo: http://localhost:8000/api
# En producción: https://tudominio.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Información de la app
NEXT_PUBLIC_APP_NAME=JASS Palian
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_DESCRIPTION=Junta Administradora de Servicios de Saneamiento de Palian - Huancayo

# Tiempo de sesión en días
NEXT_PUBLIC_SESSION_EXPIRY=7

# URL pública del frontend
NEXT_PUBLIC_URL=http://localhost:3000

# Contacto
NEXT_PUBLIC_CONTACT_PHONE=...
NEXT_PUBLIC_CONTACT_WHATSAPP=+51967801686
NEXT_PUBLIC_CONTACT_EMAIL=info@jasspalian.com
NEXT_PUBLIC_CONTACT_ADDRESS=Palian, Huancayo - Perú

# -------------------------------------------
# NGINX / PRODUCCIÓN
# -------------------------------------------
NGINX_PORT=80
NGINX_SSL_PORT=443

# Dominio para producción (ej: jasspalian.gob.pe)
DOMAIN=localhost

# -------------------------------------------
# CORS (Backend) - Separados por comas
# -------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000