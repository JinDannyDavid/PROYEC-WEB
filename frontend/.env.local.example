# ===========================================
# Frontend - Variables de Entorno Local
# ===========================================
# Copia a .env.local para desarrollo
# cp .env.local.example .env.local
# ===========================================

# API URL para desarrollo local (conecta con Django backend)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# App configuration
NEXT_PUBLIC_APP_NAME=JASS Palian
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_DESCRIPTION=Junta Administradora de Servicios de Saneamiento de Palian - Huancayo

# Tiempo de expiración de sesión (días)
NEXT_PUBLIC_SESSION_EXPIRY=7

# URLs públicas
NEXT_PUBLIC_URL=http://localhost:3000

# Contacto
NEXT_PUBLIC_CONTACT_PHONE=...
NEXT_PUBLIC_CONTACT_WHATSAPP=+51967801686
NEXT_PUBLIC_CONTACT_EMAIL=info@jasspalian.com
NEXT_PUBLIC_CONTACT_ADDRESS=Palian, Huancayo - Perú