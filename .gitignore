# ===========================================
# JASS Palian - Git Ignore
# Only track: frontend/, jasspalian_backend/, and root config files
# ===========================================

# -------------------------------------------
# EXCLUDED PROJECTS / SUBMODULES (do not track)
# -------------------------------------------
graphify-out/
hermes-agent/
G0DM0D3/
.agents/
.opencode/
.vscode/
# -------------------------------------------
# DEPENDENCIES
# -------------------------------------------
node_modules/
frontend/node_modules/
frontend/.next/
jasspalian_backend/venv/

# -------------------------------------------
# PYTHON
# -------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
env/
.venv
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# -------------------------------------------
# ENVIRONMENT FILES (secrets - never commit)
# -------------------------------------------
.env
.env.local
.env*.local
.env.production
frontend/.env.local
frontend/.env.production
jasspalian_backend/.env
AGENTS.md
# -------------------------------------------
# DATABASE
# -------------------------------------------
*.sqlite3
db.sqlite3
*.sql
*.dump

# -------------------------------------------
# IDE
# -------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# -------------------------------------------
# OS
# -------------------------------------------
.DS_Store
Thumbs.db

# -------------------------------------------
# NEXT.JS
# -------------------------------------------
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/next-env.d.ts

# -------------------------------------------
# BUILD ARTIFACTS
# -------------------------------------------
build/
dist/
*.tsbuildinfo

# -------------------------------------------
# DOCKER
# -------------------------------------------
.docker/
docker-compose.override.yml
docker-compose.workbench.yml
docker-compose.windows.yml

# -------------------------------------------
# LOGS
# -------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------------------------
# COVERAGE / TESTS
# -------------------------------------------
coverage/
.nyc_output/
htmlcov/
.coverage
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx